<launch>
    <arg name =" string " default ="Hello, ROS2!" / >

    <node
        pkg="receiver"
        exec="receiver.py"
        name="receiver"
        output="screen"
    >
    <param name =" string " value ="$( var string )" / >
    <param from ="$( find -pkg - share example )/ config / receiver . yaml "/ >
    </node>
</launch>