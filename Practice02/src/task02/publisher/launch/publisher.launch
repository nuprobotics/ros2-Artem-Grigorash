<launch>
    <arg name =" string " default ="Hello, ROS2!" / >

    <node
        pkg="publisher"
        exec="publisher.py"
        name="publisher"
        output="screen"
    >
    <param name =" string " value ="$( var string )" / >
    <param from ="$( find -pkg - share example )/ config / publisher . yaml "/ >
    </node>
</launch>
